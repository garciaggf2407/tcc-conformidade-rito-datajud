      <bpmndi:BPMNEdge id="F_Audiencia_JuncaoConciliacao_di" bpmnElement="F_Audiencia_JuncaoConciliacao"><di:waypoint x="640" y="180" /><di:waypoint x="685" y="180" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="JuncaoConciliacao_di" bpmnElement="JuncaoConciliacao" isMarkerVisible="true"><dc:Bounds x="685" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="JulgamentoConforme_di" bpmnElement="JulgamentoConforme" isMarkerVisible="true"><dc:Bounds x="785" y="155" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="840" y="200" width="90" height="70" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

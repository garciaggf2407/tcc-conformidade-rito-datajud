      <bpmndi:BPMNShape id="Sentenca_di" bpmnElement="Sentenca"><dc:Bounds x="1005" y="355" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TransitoEmJulgado_di" bpmnElement="TransitoEmJulgado"><dc:Bounds x="1167" y="372" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1145" y="415" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotaContestacao_di" bpmnElement="NotaContestacao"><dc:Bounds x="760" y="10" width="250" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotaPrazo_di" bpmnElement="NotaPrazo"><dc:Bounds x="1005" y="215" width="210" height="85" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_Distribuicao_JuncaoEmenda_di" bpmnElement="F_Distribuicao_JuncaoEmenda"><di:waypoint x="68" y="180" /><di:waypoint x="105" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_JuncaoEmenda_InicialEmOrdem_di" bpmnElement="F_JuncaoEmenda_InicialEmOrdem"><di:waypoint x="155" y="180" /><di:waypoint x="195" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_InicialEmOrdem_Emenda_di" bpmnElement="F_InicialEmOrdem_Emenda"><di:waypoint x="220" y="155" /><di:waypoint x="220" y="100" /><bpmndi:BPMNLabel><dc:Bounds x="225" y="120" width="22" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Emenda_JuncaoEmenda_di" bpmnElement="F_Emenda_JuncaoEmenda"><di:waypoint x="160" y="65" /><di:waypoint x="130" y="65" /><di:waypoint x="130" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_InicialEmOrdem_SentencaLiminar_di" bpmnElement="F_InicialEmOrdem_SentencaLiminar"><di:waypoint x="245" y="180" /><di:waypoint x="305" y="180" /><bpmndi:BPMNLabel><dc:Bounds x="263" y="162" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SentencaLiminar_Conciliacao_di" bpmnElement="F_SentencaLiminar_Conciliacao"><di:waypoint x="355" y="180" /><di:waypoint x="425" y="180" /><bpmndi:BPMNLabel><dc:Bounds x="378" y="162" width="22" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_SentencaLiminar_JuncaoSentenca_di" bpmnElement="F_SentencaLiminar_JuncaoSentenca"><di:waypoint x="330" y="205" /><di:waypoint x="330" y="480" /><di:waypoint x="940" y="480" /><di:waypoint x="940" y="415" /><bpmndi:BPMNLabel><dc:Bounds x="336" y="230" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>

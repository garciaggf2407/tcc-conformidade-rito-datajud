<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="DefinicoesRitoComum" targetNamespace="http://tcc.ite/rito-comum">
  <bpmn:process id="RitoComum" name="Fase de conhecimento do procedimento comum" isExecutable="false">
    <bpmn:startEvent id="Distribuicao" name="Distribuição">
      <bpmn:outgoing>F_Distribuicao_JuncaoEmenda</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="JuncaoEmenda">
      <bpmn:incoming>F_Distribuicao_JuncaoEmenda</bpmn:incoming>
      <bpmn:incoming>F_Emenda_JuncaoEmenda</bpmn:incoming>
      <bpmn:outgoing>F_JuncaoEmenda_InicialEmOrdem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="InicialEmOrdem" name="Petição inicial em ordem?">
      <bpmn:incoming>F_JuncaoEmenda_InicialEmOrdem</bpmn:incoming>
      <bpmn:outgoing>F_InicialEmOrdem_Emenda</bpmn:outgoing>
      <bpmn:outgoing>F_InicialEmOrdem_SentencaLiminar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Emenda" name="Emenda da inicial (art. 321)">
      <bpmn:incoming>F_InicialEmOrdem_Emenda</bpmn:incoming>
      <bpmn:outgoing>F_Emenda_JuncaoEmenda</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SentencaLiminar" name="Sentença liminar? (arts. 330 e 332)">
      <bpmn:incoming>F_InicialEmOrdem_SentencaLiminar</bpmn:incoming>
      <bpmn:outgoing>F_SentencaLiminar_Conciliacao</bpmn:outgoing>
      <bpmn:outgoing>F_SentencaLiminar_JuncaoSentenca</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="HaConciliacao" name="Audiência de conciliação? (art. 334)">
      <bpmn:incoming>F_SentencaLiminar_Conciliacao</bpmn:incoming>
      <bpmn:outgoing>F_HaConciliacao_Audiencia</bpmn:outgoing>
      <bpmn:outgoing>F_HaConciliacao_JuncaoConciliacao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AudienciaConciliacao" name="Audiência de conciliação">
      <bpmn:incoming>F_HaConciliacao_Audiencia</bpmn:incoming>
      <bpmn:outgoing>F_Audiencia_JuncaoConciliacao</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="JuncaoConciliacao">
      <bpmn:incoming>F_HaConciliacao_JuncaoConciliacao</bpmn:incoming>
      <bpmn:incoming>F_Audiencia_JuncaoConciliacao</bpmn:incoming>
      <bpmn:outgoing>F_JuncaoConciliacao_JulgamentoConforme</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="JulgamentoConforme" name="Julgamento conforme o estado do processo? (arts. 354 e 355)">
      <bpmn:incoming>F_JuncaoConciliacao_JulgamentoConforme</bpmn:incoming>
      <bpmn:outgoing>F_JulgamentoConforme_Saneamento</bpmn:outgoing>
      <bpmn:outgoing>F_JulgamentoConforme_JuncaoSentenca</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Saneamento" name="Saneamento e organização (art. 357)">
      <bpmn:incoming>F_JulgamentoConforme_Saneamento</bpmn:incoming>
      <bpmn:outgoing>F_Saneamento_HaProva</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="HaProva" name="Há prova a produzir em audiência?">
      <bpmn:incoming>F_Saneamento_HaProva</bpmn:incoming>
      <bpmn:outgoing>F_HaProva_Instrucao</bpmn:outgoing>
      <bpmn:outgoing>F_HaProva_JuncaoInstrucao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AudienciaInstrucao" name="Audiência de instrução e julgamento (art. 358)">
      <bpmn:incoming>F_HaProva_Instrucao</bpmn:incoming>
      <bpmn:outgoing>F_Instrucao_JuncaoInstrucao</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="JuncaoInstrucao">
      <bpmn:incoming>F_HaProva_JuncaoInstrucao</bpmn:incoming>
      <bpmn:incoming>F_Instrucao_JuncaoInstrucao</bpmn:incoming>
      <bpmn:outgoing>F_JuncaoInstrucao_JuncaoSentenca</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="JuncaoSentenca">
      <bpmn:incoming>F_SentencaLiminar_JuncaoSentenca</bpmn:incoming>
      <bpmn:incoming>F_JulgamentoConforme_JuncaoSentenca</bpmn:incoming>
      <bpmn:incoming>F_JuncaoInstrucao_JuncaoSentenca</bpmn:incoming>
      <bpmn:outgoing>F_JuncaoSentenca_Sentenca</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Sentenca" name="Sentença">
      <bpmn:incoming>F_JuncaoSentenca_Sentenca</bpmn:incoming>
      <bpmn:outgoing>F_Sentenca_Transito</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="TransitoEmJulgado" name="Trânsito em julgado">
      <bpmn:incoming>F_Sentenca_Transito</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Distribuicao_JuncaoEmenda" sourceRef="Distribuicao" targetRef="JuncaoEmenda" />
    <bpmn:sequenceFlow id="F_JuncaoEmenda_InicialEmOrdem" sourceRef="JuncaoEmenda" targetRef="InicialEmOrdem" />
    <bpmn:sequenceFlow id="F_InicialEmOrdem_Emenda" name="Não" sourceRef="InicialEmOrdem" targetRef="Emenda" />
    <bpmn:sequenceFlow id="F_Emenda_JuncaoEmenda" sourceRef="Emenda" targetRef="JuncaoEmenda" />
    <bpmn:sequenceFlow id="F_InicialEmOrdem_SentencaLiminar" name="Sim" sourceRef="InicialEmOrdem" targetRef="SentencaLiminar" />
    <bpmn:sequenceFlow id="F_SentencaLiminar_Conciliacao" name="Não" sourceRef="SentencaLiminar" targetRef="HaConciliacao" />
    <bpmn:sequenceFlow id="F_SentencaLiminar_JuncaoSentenca" name="Sim" sourceRef="SentencaLiminar" targetRef="JuncaoSentenca" />
    <bpmn:sequenceFlow id="F_HaConciliacao_Audiencia" name="Sim" sourceRef="HaConciliacao" targetRef="AudienciaConciliacao" />
    <bpmn:sequenceFlow id="F_HaConciliacao_JuncaoConciliacao" name="Não (dispensada)" sourceRef="HaConciliacao" targetRef="JuncaoConciliacao" />
    <bpmn:sequenceFlow id="F_Audiencia_JuncaoConciliacao" sourceRef="AudienciaConciliacao" targetRef="JuncaoConciliacao" />
    <bpmn:sequenceFlow id="F_JuncaoConciliacao_JulgamentoConforme" sourceRef="JuncaoConciliacao" targetRef="JulgamentoConforme" />
    <bpmn:sequenceFlow id="F_JulgamentoConforme_Saneamento" name="Não" sourceRef="JulgamentoConforme" targetRef="Saneamento" />
    <bpmn:sequenceFlow id="F_JulgamentoConforme_JuncaoSentenca" name="Sim" sourceRef="JulgamentoConforme" targetRef="JuncaoSentenca" />
    <bpmn:sequenceFlow id="F_Saneamento_HaProva" sourceRef="Saneamento" targetRef="HaProva" />
    <bpmn:sequenceFlow id="F_HaProva_Instrucao" name="Sim" sourceRef="HaProva" targetRef="AudienciaInstrucao" />
    <bpmn:sequenceFlow id="F_HaProva_JuncaoInstrucao" name="Não" sourceRef="HaProva" targetRef="JuncaoInstrucao" />
    <bpmn:sequenceFlow id="F_Instrucao_JuncaoInstrucao" sourceRef="AudienciaInstrucao" targetRef="JuncaoInstrucao" />
    <bpmn:sequenceFlow id="F_JuncaoInstrucao_JuncaoSentenca" sourceRef="JuncaoInstrucao" targetRef="JuncaoSentenca" />
    <bpmn:sequenceFlow id="F_JuncaoSentenca_Sentenca" sourceRef="JuncaoSentenca" targetRef="Sentenca" />
    <bpmn:sequenceFlow id="F_Sentenca_Transito" sourceRef="Sentenca" targetRef="TransitoEmJulgado" />
    <bpmn:textAnnotation id="NotaContestacao">
      <bpmn:text>Contestação (art. 335) e réplica (art. 351) não são identificáveis nos dados: todas as petições vêm como "Petição (outras)".</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssociacaoContestacao" sourceRef="NotaContestacao" targetRef="JuncaoConciliacao" />
    <bpmn:textAnnotation id="NotaPrazo">
      <bpmn:text>Prazo do juiz: 30 dias úteis contados da Conclusão (art. 226). Medido à parte, na seção 4.3.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssociacaoPrazo" sourceRef="NotaPrazo" targetRef="Sentenca" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DiagramaRitoComum">
    <bpmndi:BPMNPlane id="PlanoRitoComum" bpmnElement="RitoComum">
      <bpmndi:BPMNShape id="Distribuicao_di" bpmnElement="Distribuicao"><dc:Bounds x="32" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="20" y="205" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
